	<queryString language="SQL"><![CDATA[SELECT IdEtnia, descripcion FROM dbo.Etnia WHERE ($P{P_DESCRIPCION} IS NULL OR $P{P_DESCRIPCION} = '' OR descripcion LIKE '%' + $P{P_DESCRIPCION} + '%') ORDER BY IdEtnia]]></queryString>

