	<parameter name="P_DESCRIPCION" class="java.lang.String" isForPrompting="false"/>
	<queryString language="SQL">
		<![CDATA[SELECT IdRol, DescRol, Sueldo
FROM dbo.Rol
WHERE ($P{P_DESCRIPCION} IS NULL OR $P{P_DESCRIPCION} = '' OR DescRol LIKE '%' + $P{P_DESCRIPCION} + '%')
ORDER BY IdRol]]>
	</queryString>
