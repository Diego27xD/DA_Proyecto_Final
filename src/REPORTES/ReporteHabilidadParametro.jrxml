 <parameter name="P_DESCRIPCION" class="java.lang.String" isForPrompting="false"/>
	<queryString language="SQL"><![CDATA[SELECT Id_Habilidad, DescHab FROM dbo.Habilidades WHERE ($P{P_DESCRIPCION} IS NULL OR $P{P_DESCRIPCION} = '' OR DescHab LIKE '%' + $P{P_DESCRIPCION} + '%') ORDER BY Id_Habilidad]]></queryString>

